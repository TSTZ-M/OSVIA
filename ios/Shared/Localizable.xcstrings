  "strings": {
    "Timed out - open the app": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timed out - open the app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已超时，请回到应用查看"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已逾時，請回到 App 查看"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイムアウトしました。アプリで確認してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간이 초과되었습니다. 앱에서 확인하세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo agotado: abre la app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Délai dépassé : ouvrez l’app"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung – App öffnen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo esgotado: abra o app"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo scaduto: apri l’app"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время вышло — откройте приложение"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaman aşımı — uygulamayı açın"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá thời gian — hãy mở ứng dụng"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมดเวลา เปิดแอปเพื่อดู"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu habis — buka aplikasi"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت المهلة — افتح التطبيق"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय समाप्त — ऐप खोलें"
          }
        }
      }
    },
