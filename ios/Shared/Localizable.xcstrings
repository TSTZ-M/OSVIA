    "Jump into chat, voice, mail or tasks. Pick the entry for small and Lock Screen widgets.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump into chat, voice, mail or tasks. Pick the entry for small and Lock Screen widgets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一点就开始对话、语音，或直达邮箱和任务。小尺寸和锁屏可选入口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一點就開始對話、語音，或直達郵件和任務。小尺寸和鎖定畫面可選入口。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャット、音声、メール、タスクにすぐ移動。小サイズとロック画面では入口を選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화, 음성, 메일, 작업으로 바로 이동합니다. 작은 크기와 잠금 화면에서는 입구를 고를 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accede al chat, la voz, el correo o las tareas. En tamaño pequeño y en la pantalla de bloqueo puedes elegir el acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accédez au chat, à la voix, aux mails ou aux tâches. Choisissez l’entrée pour le petit format et l’écran verrouillé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt zu Chat, Sprache, Mail oder Aufgaben. Für kleine Widgets und den Sperrbildschirm wählbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vá direto ao chat, voz, e-mail ou tarefas. Escolha a entrada nos widgets pequenos e na tela bloqueada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai subito a chat, voce, posta o attività. Scegli l’accesso per i widget piccoli e la schermata di blocco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрый переход в чат, голос, почту или задачи. Для малого размера и экрана блокировки можно выбрать пункт."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet, ses, posta veya görevlere hızlıca geçin. Küçük boyut ve Kilit Ekranı için giriş seçilebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vào nhanh trò chuyện, giọng nói, thư hoặc tác vụ. Có thể chọn lối vào cho widget nhỏ và màn hình khóa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไปที่แชท เสียง เมล หรืองานได้ทันที เลือกทางเข้าได้สำหรับขนาดเล็กและหน้าจอล็อก"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsung ke obrolan, suara, email, atau tugas. Pilih pintu masuk untuk widget kecil dan layar kunci."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقل مباشرة إلى الدردشة أو الصوت أو البريد أو المهام. يمكن اختيار المدخل للحجم الصغير وشاشة القفل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैट, आवाज़, मेल या कार्य पर सीधे जाएँ। छोटे आकार और लॉक स्क्रीन के लिए प्रवेश चुनें।"
          }
        }
      }
    },
