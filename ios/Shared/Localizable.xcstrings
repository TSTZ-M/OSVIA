    "Open OSVIA and start voice input.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open OSVIA and start voice input."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一键打开 OSVIA 并开始语音输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一鍵開啟 OSVIA 並開始語音輸入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OSVIA を開いて音声入力を始めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OSVIA를 열고 음성 입력을 시작합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre OSVIA y empieza a dictar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre OSVIA et lance la saisie vocale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet OSVIA und startet die Spracheingabe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o OSVIA e inicia a entrada de voz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre OSVIA e avvia l’input vocale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть OSVIA и начать голосовой ввод."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OSVIA’yı açar ve sesli girişi başlatır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở OSVIA và bắt đầu nhập bằng giọng nói."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด OSVIA และเริ่มป้อนด้วยเสียง"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka OSVIA dan mulai input suara."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح OSVIA وابدأ الإدخال الصوتي."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "OSVIA खोलें और वॉइस इनपुट शुरू करें।"
          }
        }
      }
    },
